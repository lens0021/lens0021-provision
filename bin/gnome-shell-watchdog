#!/usr/bin/env python3
"""Recover the desktop when the GNOME Shell compositor wedges.

This machine freezes every day or two: gnome-shell stops servicing its main
loop while the kernel and every system service stay alive and keep logging.
Every escape a user would reach for is blocked here.

Ctrl+Alt+F3 does nothing, because under Wayland mutter holds the keyboard
through evdev and the VT-switch keys never reach logind. The power key does
nothing, because gsd-media-keys holds a block-mode handle-power-key inhibitor
that a frozen GNOME never releases, and logind honours low-level locks
unconditionally. SysRq would work, but PrtScr is Fn+F10 on this keyboard and
the embedded controller suppresses other keys while Fn is held, so the letter
after it never arrives; no spare key is left to remap either.

The system layer stays healthy throughout, so a root service can do what the
user cannot. Two triggers, one recovery:

  * a periodic D-Bus probe of org.gnome.Shell over the user's session bus, and
  * the power button, read straight off its evdev node.

Reading the button directly is the point: it sidesteps both logind and the
GNOME inhibitor that make the press useless otherwise, and it is the one key
on this laptop that can be hit with a single finger. A press burst only acts
if a probe confirms the shell really is wedged, so a healthy desktop keeps its
normal power-button behaviour.

It also suspends on lid close, which GNOME refuses to do here. Both logind
(HandleLidSwitchDocked, "ignore" by default once more than one display is
connected) and gsd-power ("no external monitors or session inactive for a
while; uninhibiting lid close") keep the machine awake while the dock's
monitor is attached. That default assumes a clamshell setup, and this laptop
has no external keyboard, so a closed lid means no way to type at all.
Suspending through `systemctl suspend` still honours block-mode sleep
inhibitors, so Caffeine keeps working as the override.

On 2026-09-22 the first real freeze after deployment caught this service doing
nothing at all: no missed probe, no reaction to a four-press burst, no
reaction to a lid close it had handled correctly an hour earlier. It had
wedged itself, somewhere in a probe, and said nothing. So the loop is now
built to survive its own bugs rather than to be provably free of them:

  * the probe runs in a throwaway thread, so it can hang without taking the
    loop with it, and its subprocess gets its own process group to kill;
  * every branch pings the systemd watchdog, so a stall that outlasts
    WatchdogSec has systemd kill and restart the service instead of leaving a
    silent corpse;
  * a heartbeat line every HEARTBEAT seconds means silence in the journal is
    itself evidence, and bounds how far back the next investigation starts.

Recovery dumps kernel state through sysrq first. The hang leaves no trace of
its own in the journal, so those dumps are the only material we get for
finding the cause; read them after the next freeze with

    journalctl -b -1 -k
"""

import glob
import os
import queue
import select
import signal
import socket
import struct
import subprocess
import sys
import threading
import time

INTERVAL = int(os.environ.get("INTERVAL", 30))  # seconds between probes
PING_TIMEOUT = int(os.environ.get("PING_TIMEOUT", 10))  # seconds per probe
STRIKES = int(os.environ.get("STRIKES", 6))  # misses before acting
ACTION = os.environ.get("ACTION", "restart")  # restart | dump-only
POWER_PRESSES = int(os.environ.get("POWER_PRESSES", 3))  # presses to force it
POWER_WINDOW = float(os.environ.get("POWER_WINDOW", 45.0))  # within N seconds
RESUME_GRACE = float(os.environ.get("RESUME_GRACE", 60.0))  # settle after resume
HEARTBEAT = float(os.environ.get("HEARTBEAT", 600.0))  # seconds between "alive"
LID_SUSPEND = os.environ.get("LID_SUSPEND", "1") != "0"

EV_KEY, KEY_POWER, KEY_PRESS = 0x01, 116, 1
EV_SW, SW_LID, LID_SHUT = 0x05, 0, 1
EVENT = struct.Struct("llHHi")


def log(msg):
    print(msg, flush=True)


def notify(state):
    """sd_notify without the systemd python bindings."""
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr.startswith("@"):
        addr = "\0" + addr[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
            sock.connect(addr)
            sock.sendall(state.encode())
    except OSError:
        pass


def run(argv, timeout):
    """Run argv in its own process group, killing the group on timeout."""
    proc = subprocess.Popen(
        argv,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
        text=True,
    )
    try:
        out, err = proc.communicate(timeout=timeout)
        return proc.returncode, (out or ""), (err or "").strip()
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        return 124, "", "timed out"


def backtrace(uid):
    """Log where every gnome-shell thread is stuck, before gdm takes it away.

    The freeze leaves no trace of its own, and the two standing suspects sit on
    opposite sides of the same main loop: mutter itself, or an extension doing
    blocking work inside the shell process. Only a stack answers that, and only
    while the wedged process is still alive.
    """
    code, out, err = run(["pgrep", "-u", str(uid), "-x", "gnome-shell"], 10)
    pid = out.split("\n")[0].strip() if not code else ""
    if not pid.isdigit():
        log(f"no gnome-shell pid to trace: {err or out!r}")
        return
    code, out, err = run(["eu-stack", "-p", pid], 45)
    if code:
        log(f"eu-stack on pid {pid} failed: {err}")
        return
    lines = out.splitlines()[:400]
    log(f"--- eu-stack of gnome-shell pid {pid}, {len(lines)} lines ---")
    for line in lines:
        log(line)
    log("--- end eu-stack ---")


def evdev_node(wanted):
    """The /dev/input node of the named input device, or None if absent."""
    for sysdev in sorted(glob.glob("/sys/class/input/event*")):
        try:
            name = open(f"{sysdev}/device/name").read().strip()
        except OSError:
            continue
        if name == wanted:
            return f"/dev/input/{os.path.basename(sysdev)}"
    return None


def suspend():
    """Suspend, unless something holds a block-mode sleep inhibitor."""
    code, _, err = run(["systemctl", "suspend"], 20)
    log("lid closed, suspending" if not code else f"lid closed but suspend was refused: {err}")


def active_graphical_uid():
    """The uid of the active graphical session, or None if there is none.

    The gdm greeter runs a gnome-shell of its own as uid 42; it is not ours to
    restart, so anything below 1000 is skipped.
    """

    def show(*args):
        proc = subprocess.run(
            ["loginctl", *args, "--value"], capture_output=True, text=True, timeout=10
        )
        return proc.stdout.strip() if proc.returncode == 0 else ""

    try:
        sid = show("show-seat", "seat0", "--property=ActiveSession")
        if not sid:
            return None
        if show("show-session", sid, "--property=Type") not in ("wayland", "x11"):
            return None
        uid = show("show-session", sid, "--property=User")
    except (subprocess.TimeoutExpired, OSError) as exc:
        log(f"loginctl did not answer: {exc}")
        return None
    if not uid.isdigit() or int(uid) < 1000:
        return None
    return int(uid) if os.path.exists(f"/run/user/{uid}/bus") else None


def shell_answers(uid):
    """True if gnome-shell replied to a D-Bus probe.

    The call happens on a throwaway thread. A probe that wedges in a way the
    subprocess timeout cannot reach then costs one leaked thread instead of
    the whole watchdog, which is exactly how the 2026-09-22 freeze went
    unanswered.
    """
    answer = queue.Queue(maxsize=1)

    def ask():
        code, _, _ = run(
            [
                "setpriv", f"--reuid={uid}", f"--regid={uid}", "--init-groups",
                "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
                "gdbus", "call", "--session", "--timeout", str(PING_TIMEOUT),
                "--dest", "org.gnome.Shell",
                "--object-path", "/org/gnome/Shell",
                "--method", "org.freedesktop.DBus.Peer.Ping",
            ],
            PING_TIMEOUT + 2,
        )
        try:
            answer.put_nowait(code == 0)
        except queue.Full:
            pass

    threading.Thread(target=ask, daemon=True).start()
    try:
        return answer.get(timeout=PING_TIMEOUT + 5)
    except queue.Empty:
        log("probe thread did not return, counting it as a miss")
        return False


def recover(why, uid):
    log(f"{why}; dumping state")
    backtrace(uid)
    for key in ("w", "t"):
        try:
            with open("/proc/sysrq-trigger", "w") as trigger:
                trigger.write(key)
        except OSError as exc:
            log(f"sysrq {key} failed: {exc}")
    if ACTION != "restart":
        log(f"ACTION={ACTION}, leaving the session alone")
        return
    log("restarting the display manager")
    code, _, err = run(["systemctl", "restart", "gdm.service"], 60)
    if code:
        log(f"gdm restart failed: {err}")


def main():
    kinds = {"Power Button": "power"}
    if LID_SUSPEND:
        kinds["Lid Switch"] = "lid"
    fds = {}
    for name, kind in kinds.items():
        node = evdev_node(name)
        if not node:
            log(f"no {name} found")
            continue
        try:
            fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = kind
            log(f"watching the {name.lower()} on {node}")
        except OSError as exc:
            log(f"cannot read {node}: {exc}")
    if not fds:
        log("no input devices, falling back to probe-only")
    notify("READY=1")

    strikes, presses = 0, []
    # Act on the open -> shut transition only. The kernel re-reports the switch
    # state on resume, so reacting to the level would suspend again the moment
    # the machine was woken with the lid still down.
    lid_shut = False
    # CLOCK_MONOTONIC stops while the machine is suspended, so a resume is only
    # visible in CLOCK_BOOTTIME. Schedule on the former, spot gaps with the latter.
    last_boot = time.clock_gettime(time.CLOCK_BOOTTIME)
    deadline = time.monotonic() + INTERVAL
    grace_until = 0.0
    beat = time.monotonic()

    while True:
        notify("WATCHDOG=1")
        now = time.monotonic()
        if now - beat >= HEARTBEAT:
            log(f"alive, {strikes} missed probe(s) outstanding")
            beat = now

        timeout = max(0.0, deadline - now)
        forced = False

        ready = select.select(list(fds), [], [], timeout)[0] if fds else []
        if not fds:
            time.sleep(timeout)
        for fd in ready:
            try:
                data = os.read(fd, EVENT.size * 64)
            except OSError:
                continue
            now = time.monotonic()
            for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, etype, code, value = EVENT.unpack_from(data, off)
                if fds[fd] == "lid" and etype == EV_SW and code == SW_LID:
                    was, lid_shut = lid_shut, value == LID_SHUT
                    if lid_shut and not was:
                        suspend()
                elif (
                    fds[fd] == "power"
                    and etype == EV_KEY
                    and code == KEY_POWER
                    and value == KEY_PRESS
                ):
                    presses = [t for t in presses if now - t < POWER_WINDOW]
                    presses.append(now)
                    log(f"power button press {len(presses)}/{POWER_PRESSES}")
                    if len(presses) >= POWER_PRESSES:
                        presses.clear()
                        forced = True
        if ready and not forced:
            continue

        now = time.monotonic()
        now_boot = time.clock_gettime(time.CLOCK_BOOTTIME)
        # A suspend shows up as a boottime gap far larger than the interval. The
        # session is still settling just after a resume, and the press that woke
        # the machine is not a recovery request, so drop both.
        if now_boot - last_boot > INTERVAL * 3:
            log(f"resumed after a {now_boot - last_boot:.0f}s gap, settling")
            strikes, presses, forced = 0, [], False
            grace_until = now + RESUME_GRACE
        last_boot = now_boot
        if not forced:
            deadline = now + INTERVAL
        elif now < grace_until:
            log("power button burst ignored, the session just resumed")
            continue

        uid = active_graphical_uid()
        if uid is None:
            if forced:
                log("power button burst ignored, no active graphical session")
            strikes = 0
            continue

        if shell_answers(uid):
            if strikes:
                log(f"shell answered again after {strikes} miss(es)")
            strikes = 0
            if forced:
                log("power button burst ignored, the shell is responsive")
            continue

        if forced:
            recover("power button burst and the shell did not answer", uid)
        else:
            strikes += 1
            log(f"gnome-shell missed probe {strikes}/{STRIKES}")
            if strikes < STRIKES:
                continue
            recover(f"compositor unresponsive for ~{STRIKES * INTERVAL}s", uid)

        strikes, presses = 0, []
        # Let the replacement session come up before probing again.
        deadline = time.monotonic() + 120


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
